NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
OWNER_EMAIL=
CRON_SECRET=

# Optional free daily market discovery and close data.
OPENFIGI_API_KEY=
TWELVE_DATA_API_KEY=
# Optional free EOD closes for European and Oslo tickers (eodhd.com, 20 calls/day free).
EODHD_API_KEY=

# Optional. Switches on the AI analyst through the Vercel AI Gateway.
# On a Vercel deployment the OIDC token is used automatically and this can stay empty.
AI_GATEWAY_API_KEY=
# Optional override, defaults to anthropic/claude-sonnet-5.
AI_ANALYST_MODEL=
